FROM python:3.11-slim

WORKDIR /app

# System deps needed by Pillow/matplotlib
RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-v2.txt .
# Install CPU-only torch for the container (GPU not available at serve time / edge)
RUN pip install --no-cache-dir torch==2.3.1 torchvision==0.18.1 \
    --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements-v2.txt \
    --index-url https://pypi.org/simple \
    --extra-index-url https://pypi.org/simple

# Pre-cache torchvision pretrained weights so container starts instantly without runtime downloads
RUN python -c "import torchvision.models as models; models.mobilenet_v3_small(weights=models.MobileNet_V3_Small_Weights.IMAGENET1K_V1)"

COPY src/ ./src/
COPY api/ ./api/
# Trained model artifact and config (produced by python -m src.select_best)
COPY models/ ./models/

ENV MODEL_PATH=models/model.pt
ENV CONFIG_PATH=models/model_config.json
ENV LOG_DIR=logs
ENV PORT=7000
EXPOSE 7000

CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-7000}"]
