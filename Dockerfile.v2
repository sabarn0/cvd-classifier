FROM python:3.11-slim

WORKDIR /app

# System deps needed by Pillow/matplotlib
RUN apt-get update && apt-get install -y --no-install-recommends \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-v2.txt .
# Install CPU-only torch for the container (GPU not available at serve time / edge)
RUN pip install --no-cache-dir torch==2.3.1 torchvision==0.18.1 \
    --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements-v2.txt \
    --index-url https://pypi.org/simple \
    --extra-index-url https://pypi.org/simple

COPY src/ ./src/
COPY api/ ./api/
# Trained model artifact and config (produced by python -m src.select_best)
COPY models/ ./models/

ENV MODEL_PATH=models/model.pt
ENV CONFIG_PATH=models/model_config.json
ENV LOG_DIR=logs
EXPOSE 7000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "7000"]
